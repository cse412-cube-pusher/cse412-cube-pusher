<?xml version="1.0"?>
<robot>
  <link name="camera_link">
    <inertial>
      <origin xyz="-0.015 0 0" />
      <mass value="0.03" />
      <inertia ixx="0.00000625" iyy="0.0000045" izz="0.00000625" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="-0.015 0 0" />
      <geometry>
        <box size="0.03 0.04 0.03" />
      </geometry>
      <material name="camera_dark">
        <color rgba="0.15 0.15 0.15 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="-0.015 0 0" />
      <geometry>
        <box size="0.03 0.04 0.03" />
      </geometry>
    </collision>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="${chassis_x + 0.22} 0 ${0.20 - chassis_z}" rpy="0 0.20 0" />
  </joint>
  <link name="camera_optical_frame" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679" />
  </joint>
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera name="front_camera">
        <camera_info_topic>/camera/camera_info</camera_info_topic>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>12.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
