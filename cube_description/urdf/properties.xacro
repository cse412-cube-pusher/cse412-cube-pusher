<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="pusher_arm_mass" value="0.07" />
  <xacro:property name="pusher_arm_length" value="0.12" />
  <xacro:property name="pusher_inner_width" value="0.22" />
  <xacro:property name="chassis_x" value="-0.08" />
  <xacro:property name="chassis_length" value="0.40" />
  <xacro:property name="chassis_width" value="0.30" />
  <xacro:property name="chassis_height" value="0.20" />
  <xacro:property name="chassis_mass" value="3.0" />
  <xacro:property name="chassis_z" value="0.13" />
  <xacro:property name="wheel_radius" value="0.05" />
  <xacro:property name="wheel_width" value="0.03" />
  <xacro:property name="wheel_mass" value="0.15" />
  <xacro:property name="wheel_separation" value="0.30" />
  <xacro:property name="wheel_x" value="0.0" />
  <xacro:property name="caster_radius" value="0.025" />
  <xacro:property name="caster_mass" value="0.05" />
  <xacro:property name="caster_x" value="${chassis_x - 0.15}" />
  <xacro:property name="pusher_thickness" value="0.02" />
  <xacro:property name="pusher_width" value="${pusher_inner_width + 2 * pusher_thickness}" />
  <xacro:property name="pusher_height" value="0.14" />
  <xacro:property name="pusher_mass" value="0.15" />
  <xacro:property name="pusher_z" value="0.08" />
</robot>
